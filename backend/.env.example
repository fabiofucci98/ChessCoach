# Backend variables — copy to backend/.env and adjust
POSTGRES_USER=chesscoach
POSTGRES_PASSWORD=change_me
POSTGRES_DB=chesscoach_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# Generate a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=generate_a_long_random_string
API_PORT=8000

# Windows local dev:
STOCKFISH_PATH=C:/stockfish/stockfish-windows-x86-64-avx2.exe
# Docker/Linux (also set as env in docker-compose.yml):
# STOCKFISH_PATH=/usr/games/stockfish

# --- Optional overrides (Security / CORS / logging) ---
# "development" or "production" (production fails fast if SECRET_KEY is unsafe)
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Set true to log every SQL statement
DATABASE_ECHO=false
